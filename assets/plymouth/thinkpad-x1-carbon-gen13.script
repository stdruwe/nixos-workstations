// ThinkPad X1 Carbon Gen 13 Plymouth theme.
// Inspired by santiagosantos08/t14bootanimation (MIT), commit 743725fd40e6de7cd42107eda49e8f57956697da.
// The Lenovo/LUKS sequence follows the original staging closely; the exploded
// ThinkPad component animation is intentionally omitted.

SCREEN_W = Window.GetWidth();
SCREEN_H = Window.GetHeight();

// Show the finished intro frame for roughly 500 ms before any animation
// starts. This makes the remaining xe display hand-off easy to judge visually
// without unnecessarily delaying the Lenovo -> Luks2 sequence.
START_DELAY_FRAMES   = 25;
INIT_FRAMES          = 5;
TEXT_FRAMES_PER_STEP = 6;
TEXT_TOTAL_STEPS     = 10;
TEXT_TOTAL_FRAMES    = TEXT_FRAMES_PER_STEP * TEXT_TOTAL_STEPS;
THINKPAD_FADE_END    = 50;
LUKS_SCALE_FRAMES    = 10;
PASSWORD_FADE_FRAMES = 10;
EXIT_FRAMES          = 20;
FINAL_FADE_FRAMES    = 18;
SPINNER_HOLD_FRAMES  = 250;
SPINNER_FADE_FRAMES  = 18;
SPINNER_SPEED        = 0.105;

// Large Lenovo/Luks2 title like the upstream theme. Luks2 is then reduced to
// the smaller password-prompt size.
TITLE_FONT      = "Sans Bold 112";
LUKS_FINAL_FONT = "Sans Bold 52";
PASSWORD_FONT   = "Sans Bold 20";
FINAL_FONT      = "Sans 36";
MESSAGE_FONT    = "Sans 12";

PHASE_DELAY      = 0;
PHASE_INIT       = 1;
PHASE_TEXT       = 2;
PHASE_LUKS_SCALE = 3;
PHASE_PASSWORD   = 4;
PHASE_EXIT       = 5;
PHASE_FINAL      = 6;

phase = PHASE_DELAY;
mode = Plymouth.GetMode();
if (mode != "boot")
    phase = PHASE_FINAL;

phase_frame = 0;
display_normal_flag = 0;
pw_bullets = 0;
pw_needs_update = 0;
spinner_angle = 0.0;
main_text_y = 0;
pw_y = 0;

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

// Scale the native wallpaper to Plymouth's actual drawing surface. On the
// HiDPI panel Plymouth may expose a logical viewport smaller than 2880x1800.
background_img = Image("background.png");
background_img = background_img.Scale(SCREEN_W, SCREEN_H);
background_sprite = Sprite(background_img);
background_sprite.SetX(0);
background_sprite.SetY(0);
background_sprite.SetZ(0);
background_sprite.SetOpacity(0);

// Nix renders the ThinkPad SVG directly to its final 520 px width. Plymouth
// deliberately does not resize it again, preserving librsvg's antialiasing.
thinkpad_img = Image("thinkpad.png");
thinkpad_sprite = Sprite(thinkpad_img);
thinkpad_sprite.SetX(Math.Int(SCREEN_W * 0.045));
thinkpad_sprite.SetY(Math.Int(SCREEN_H * 0.055));
thinkpad_sprite.SetZ(1);
thinkpad_sprite.SetOpacity(0);

text_seq[0] = "Lenovo";
text_seq[1] = "Lenov";
text_seq[2] = "Leno";
text_seq[3] = "Len";
text_seq[4] = "Le";
text_seq[5] = "L";
text_seq[6] = "Lu";
text_seq[7] = "Luk";
text_seq[8] = "Luks";
text_seq[9] = "Luks2";

text_img = Image.Text(text_seq[0], 1, 1, 1, 1, TITLE_FONT);
luks2_orig_img = Image.Text("Luks2", 1, 1, 1, 1, TITLE_FONT);
luks2_final_img = Image.Text("Luks2", 1, 1, 1, 1, LUKS_FINAL_FONT);

// Fixed Lenovo-red tile. The original theme keeps the rectangle while Lenovo
// is transformed into Luks2, instead of using a separate red accent bar.
lenovo_bg_src = Image("lenovo-bg.png");
lenovo_pad_x = Math.Int(SCREEN_W * 0.022);
lenovo_pad_y = Math.Int(SCREEN_H * 0.020);
lenovo_bg_w = text_img.GetWidth() + 2 * lenovo_pad_x;
lenovo_bg_h = text_img.GetHeight() + 2 * lenovo_pad_y;
lenovo_bg_x = Math.Int((SCREEN_W - lenovo_bg_w) / 2);
lenovo_bg_y = Math.Int(SCREEN_H * 0.405 - lenovo_bg_h / 2);
lenovo_bg_img = lenovo_bg_src.Scale(lenovo_bg_w, lenovo_bg_h);
lenovo_bg_sprite = Sprite(lenovo_bg_img);
lenovo_bg_sprite.SetX(lenovo_bg_x);
lenovo_bg_sprite.SetY(lenovo_bg_y);
lenovo_bg_sprite.SetZ(4);
lenovo_bg_sprite.SetOpacity(0);

text_sprite = Sprite(text_img);
text_sprite.SetZ(6);
text_sprite.SetOpacity(0);

// After the word has become Luks2, shrink it while moving it into the upper
// third of the red tile. The lower part is reserved exclusively for the PIN.
luks_scale_start_y = Math.Int(lenovo_bg_y + (lenovo_bg_h - luks2_orig_img.GetHeight()) / 2);
luks_final_center_y = Math.Int(lenovo_bg_y + lenovo_bg_h * 0.31);
luks_final_y = Math.Int(luks_final_center_y - luks2_final_img.GetHeight() / 2);

underline_src = Image("underline.png");
underline_w = Math.Int(lenovo_bg_w * 0.76);
underline_img = underline_src.Scale(underline_w, 2);
underline_x = Math.Int((SCREEN_W - underline_w) / 2);
underline_y = Math.Int(lenovo_bg_y + lenovo_bg_h * 0.78);
underline_sprite = Sprite(underline_img);
underline_sprite.SetX(underline_x);
underline_sprite.SetY(underline_y);
underline_sprite.SetZ(7);
underline_sprite.SetOpacity(0);

pw_sprite = Sprite();
pw_sprite.SetZ(8);
pw_sprite.SetOpacity(0);

message_sprite = Sprite();
message_sprite.SetZ(10);
message_sprite.SetOpacity(0);

final_text_img = Image.Text("NixOS", 1, 1, 1, 1, FINAL_FONT);
final_text_sprite = Sprite(final_text_img);
final_text_sprite.SetX(Math.Int((SCREEN_W - final_text_img.GetWidth()) / 2));
final_text_sprite.SetY(Math.Int(SCREEN_H * 0.49 - final_text_img.GetHeight() / 2));
final_text_sprite.SetZ(4);
final_text_sprite.SetOpacity(0);

spinner_src = Image("spinner.png");
spinner_size = Math.Int(SCREEN_W * 0.030);
spinner_img = spinner_src.Scale(spinner_size, spinner_size);
spinner_cx = Math.Int(SCREEN_W / 2);
spinner_cy = Math.Int(SCREEN_H * 0.585);
spinner_sprite = Sprite();
spinner_sprite.SetZ(4);
spinner_sprite.SetOpacity(0);

fun CenterTitle(img) {
    text_sprite.SetX(Math.Int((SCREEN_W - img.GetWidth()) / 2));
    main_text_y = Math.Int(lenovo_bg_y + (lenovo_bg_h - img.GetHeight()) / 2);
    text_sprite.SetY(main_text_y);
}

CenterTitle(text_img);

fun TransitionTo(new_phase) {
    phase = new_phase;
    phase_frame = -1;
}

fun UpdateDelay() {
    // Hold the complete initial frame: wallpaper + both Lenovo/ThinkPad marks.
    // Only the actual Lenovo -> Luks2 transformation is delayed.
    background_sprite.SetOpacity(1);
    text_sprite.SetImage(text_img);
    CenterTitle(text_img);
    lenovo_bg_sprite.SetOpacity(1);
    text_sprite.SetOpacity(1);
    thinkpad_sprite.SetOpacity(1);
    underline_sprite.SetOpacity(0);
    pw_sprite.SetOpacity(0);

    if (display_normal_flag)
        TransitionTo(PHASE_FINAL);
    else if (phase_frame >= START_DELAY_FRAMES - 1)
        TransitionTo(PHASE_TEXT);
}

fun UpdateInit() {
    background_sprite.SetOpacity(1);
    text_sprite.SetImage(text_img);
    CenterTitle(text_img);
    lenovo_bg_sprite.SetOpacity(1);
    text_sprite.SetOpacity(1);
    thinkpad_sprite.SetOpacity(1);

    if (phase_frame >= INIT_FRAMES - 1)
        TransitionTo(PHASE_TEXT);
}

fun UpdateText() {
    background_sprite.SetOpacity(1);

    local.step = Math.Int(phase_frame / TEXT_FRAMES_PER_STEP);
    if (local.step >= TEXT_TOTAL_STEPS)
        local.step = TEXT_TOTAL_STEPS - 1;

    local.img = Image.Text(text_seq[local.step], 1, 1, 1, 1, TITLE_FONT);
    text_sprite.SetImage(local.img);
    CenterTitle(local.img);
    lenovo_bg_sprite.SetOpacity(1);
    text_sprite.SetOpacity(1);
    thinkpad_sprite.SetOpacity(1);

    if (display_normal_flag)
        TransitionTo(PHASE_EXIT);
    else if (phase_frame >= TEXT_TOTAL_FRAMES - 1)
        TransitionTo(PHASE_LUKS_SCALE);
}

fun UpdateLuksScale() {
    background_sprite.SetOpacity(1);

    local.raw_t = Math.Min(phase_frame / (LUKS_SCALE_FRAMES - 1), 1.0);
    local.t;
    if (local.raw_t < 0.5)
        local.t = 2.0 * local.raw_t * local.raw_t;
    else
        local.t = -1.0 + (4.0 - 2.0 * local.raw_t) * local.raw_t;

    local.new_w = Math.Int(
        luks2_orig_img.GetWidth() +
        (luks2_final_img.GetWidth() - luks2_orig_img.GetWidth()) * local.t
    );
    local.new_h = Math.Int(
        luks2_orig_img.GetHeight() +
        (luks2_final_img.GetHeight() - luks2_orig_img.GetHeight()) * local.t
    );

    local.scaled = luks2_orig_img.Scale(local.new_w, local.new_h);
    text_sprite.SetImage(local.scaled);
    text_sprite.SetX(Math.Int((SCREEN_W - local.new_w) / 2));
    main_text_y = Math.Int(luks_scale_start_y + (luks_final_y - luks_scale_start_y) * local.t);
    text_sprite.SetY(main_text_y);

    lenovo_bg_sprite.SetOpacity(1);
    thinkpad_sprite.SetOpacity(1);
    underline_sprite.SetOpacity(local.t);

    if (phase_frame >= LUKS_SCALE_FRAMES - 1) {
        text_sprite.SetImage(luks2_final_img);
        text_sprite.SetX(Math.Int((SCREEN_W - luks2_final_img.GetWidth()) / 2));
        main_text_y = luks_final_y;
        text_sprite.SetY(main_text_y);
        if (display_normal_flag)
            TransitionTo(PHASE_EXIT);
        else
            TransitionTo(PHASE_PASSWORD);
    }
}

fun UpdatePassword() {
    background_sprite.SetOpacity(1);

    local.t = Math.Min(phase_frame / PASSWORD_FADE_FRAMES, 1.0);

    lenovo_bg_sprite.SetOpacity(1);
    thinkpad_sprite.SetOpacity(1);
    underline_sprite.SetOpacity(1);
    text_sprite.SetImage(luks2_final_img);
    text_sprite.SetX(Math.Int((SCREEN_W - luks2_final_img.GetWidth()) / 2));
    main_text_y = luks_final_y;
    text_sprite.SetY(main_text_y);

    if (pw_needs_update) {
        local.password_text = "";
        local.i = 0;
        for (local.i = 0; local.i < pw_bullets; local.i++)
            local.password_text = local.password_text + "*";

        local.pw_img = Image.Text(local.password_text, 1, 1, 1, 1, PASSWORD_FONT);
        pw_sprite.SetImage(local.pw_img);
        pw_sprite.SetX(Math.Int((SCREEN_W - local.pw_img.GetWidth()) / 2));
        pw_y = underline_y - local.pw_img.GetHeight() - Math.Int(SCREEN_H * 0.012);
        pw_sprite.SetY(pw_y);
        pw_needs_update = 0;
    }

    pw_sprite.SetOpacity(local.t);

    if (display_normal_flag)
        TransitionTo(PHASE_EXIT);
}

fun UpdateExit() {
    background_sprite.SetOpacity(1);

    local.raw_t = Math.Min(phase_frame / EXIT_FRAMES, 1.0);
    local.t = local.raw_t * local.raw_t;
    local.offset = Math.Int(local.t * SCREEN_H * 0.22);
    local.opacity = 1.0 - local.t;

    lenovo_bg_sprite.SetY(lenovo_bg_y + local.offset);
    text_sprite.SetY(main_text_y + local.offset);
    underline_sprite.SetY(underline_y + local.offset);
    pw_sprite.SetY(pw_y + local.offset);

    lenovo_bg_sprite.SetOpacity(local.opacity);
    text_sprite.SetOpacity(local.opacity);
    underline_sprite.SetOpacity(local.opacity);
    pw_sprite.SetOpacity(local.opacity);
    thinkpad_sprite.SetOpacity(local.opacity);

    if (phase_frame >= EXIT_FRAMES - 1) {
        lenovo_bg_sprite.SetOpacity(0);
        text_sprite.SetOpacity(0);
        underline_sprite.SetOpacity(0);
        pw_sprite.SetOpacity(0);
        thinkpad_sprite.SetOpacity(0);
        TransitionTo(PHASE_FINAL);
    }
}

fun UpdateFinal() {
    background_sprite.SetOpacity(1);

    local.fade_in = Math.Min(phase_frame / FINAL_FADE_FRAMES, 1.0);

    thinkpad_sprite.SetOpacity(local.fade_in);
    final_text_sprite.SetOpacity(local.fade_in);

    // Match the HP theme: keep the spinner moving for roughly five seconds,
    // then fade only the spinner out while the final boot frame remains.
    local.spinner_opacity = local.fade_in;
    if (phase_frame >= SPINNER_HOLD_FRAMES) {
        local.fade_out_frame = phase_frame - SPINNER_HOLD_FRAMES;
        local.spinner_opacity = 1.0 - Math.Min(local.fade_out_frame / SPINNER_FADE_FRAMES, 1.0);
    }

    if (local.spinner_opacity > 0) {
        spinner_angle += SPINNER_SPEED;
        if (spinner_angle >= 2.0 * Math.Pi)
            spinner_angle -= 2.0 * Math.Pi;

        local.rot_img = spinner_img.Rotate(spinner_angle);
        local.rot_w = local.rot_img.GetWidth();
        local.rot_h = local.rot_img.GetHeight();
        spinner_sprite.SetImage(local.rot_img);
        spinner_sprite.SetX(spinner_cx - Math.Int(local.rot_w / 2));
        spinner_sprite.SetY(spinner_cy - Math.Int(local.rot_h / 2));
    }

    spinner_sprite.SetOpacity(local.spinner_opacity);
}

fun RefreshCallback() {
    if (phase == PHASE_DELAY)
        UpdateDelay();
    else if (phase == PHASE_INIT)
        UpdateInit();
    else if (phase == PHASE_TEXT)
        UpdateText();
    else if (phase == PHASE_LUKS_SCALE)
        UpdateLuksScale();
    else if (phase == PHASE_PASSWORD)
        UpdatePassword();
    else if (phase == PHASE_EXIT)
        UpdateExit();
    else
        UpdateFinal();

    phase_frame++;
}

fun DisplayPasswordCallback(prompt, bullets) {
    pw_bullets = bullets;
    pw_needs_update = 1;
}

fun DisplayNormalCallback() {
    display_normal_flag = 1;
}

fun MessageCallback(msg) {
    local.m_img = Image.Text(msg, 0.72, 0.72, 0.72, 1, MESSAGE_FONT);
    message_sprite.SetImage(local.m_img);
    message_sprite.SetX(Math.Int((SCREEN_W - local.m_img.GetWidth()) / 2));
    message_sprite.SetY(Math.Int(SCREEN_H - local.m_img.GetHeight() - SCREEN_H * 0.025));
    message_sprite.SetOpacity(1);
}

Plymouth.SetRefreshFunction(RefreshCallback);
Plymouth.SetDisplayPasswordFunction(DisplayPasswordCallback);
Plymouth.SetDisplayNormalFunction(DisplayNormalCallback);
Plymouth.SetMessageFunction(MessageCallback);